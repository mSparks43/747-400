{
  "name": "s02_elec_panel",
  "description": "電源（1-1）の X-Plane での確認。エンジン運転中で開始し、BUS TIE・GEN CONT・UTILITY・STANDBY POWER・APU GEN・DRIVE DISC を操作して、バス・遮断器・灯・EICAS が FCOM どおりに動くかを見る。期待値は FCOM 6.10-6.30（機体 109）と LH24（notes/ATA-24.md）。",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "sleep", "seconds": 5 },
    { "do": "snapshot", "note": "開始直後", "drefs": [
      "sim/aircraft/view/acf_relative_path", "laminar/B747/button_switch/position[13]",
      "laminar/B747/electrical/standby_power/sel_dial_pos",
      "laminar/B747/electrical/bus/ac[0]", "laminar/B747/electrical/bus/ac[1]", "laminar/B747/electrical/bus/ac[2]", "laminar/B747/electrical/bus/ac[3]",
      "laminar/B747/electrical/breaker/gcb[0]", "laminar/B747/electrical/breaker/gcb[1]", "laminar/B747/electrical/breaker/gcb[2]", "laminar/B747/electrical/breaker/gcb[3]",
      "laminar/B747/electrical/breaker/ssb", "laminar/B747/electrical/bus/stby_main", "laminar/B747/electrical/bus/stby_apu",
      "laminar/B747/electrical/bus/xfr_capt", "laminar/B747/electrical/bus/xfr_fo",
      "sim/cockpit2/electrical/bus_volts[0]", "sim/flightmodel/engine/ENGN_N2_[0]" ] },
    { "do": "cas", "note": "開始直後" },
    { "do": "switch", "note": "STANDBY POWER AUTO", "dref": "laminar/B747/electrical/standby_power/sel_dial_pos", "value": 1,
      "cmd": "laminar/B747/electrical/standby_power/sel_dial_up", "cmd_down": "laminar/B747/electrical/standby_power/sel_dial_dn" },
    { "do": "check", "note": "4 発の IDG が GCB で母線に（FCOM p.798）", "dref": "laminar/B747/electrical/breaker/gcb[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "GCB 4", "dref": "laminar/B747/electrical/breaker/gcb[3]", "op": "==", "value": 1 },
    { "do": "check", "note": "IDG が両側にあれば SSB 閉（FCOM p.797）", "dref": "laminar/B747/electrical/breaker/ssb", "op": "==", "value": 1 },
    { "do": "check", "note": "AC 1", "dref": "laminar/B747/electrical/bus/ac[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "AC 4", "dref": "laminar/B747/electrical/bus/ac[3]", "op": "==", "value": 1 },
    { "do": "check", "note": "main standby bus（FCOM p.804）", "dref": "laminar/B747/electrical/bus/stby_main", "op": "==", "value": 1 },
    { "do": "check", "note": "APU standby bus（FCOM p.804）", "dref": "laminar/B747/electrical/bus/stby_apu", "op": "==", "value": 1 },
    { "do": "check", "note": "X-Plane のバス電圧（音は 28 V で判定）", "dref": "sim/cockpit2/electrical/bus_volts[0]", "op": ">=", "value": 27.5 },
    { "do": "check", "note": "ELEC AC BUS 1 が出ていない", "dref": "laminar/B747/CAS/caution_status[15]", "op": "==", "value": 0 },
    { "do": "check", "note": "ELEC GEN OFF 1 が出ていない", "dref": "laminar/B747/CAS/advisory_status[100]", "op": "==", "value": 0 },
    { "do": "check", "note": "PSEU：地上（ATA29_32 p.322）", "dref": "laminar/B747/gear/air_ground/pri_gnd", "op": "==", "value": 1 },
    { "do": "check", "note": "PSEU：air ではない", "dref": "laminar/B747/gear/air_ground/pri_air", "op": "==", "value": 0 },
    { "do": "check", "note": "PSEU：前脚圧縮（ATA29_32 p.310）", "dref": "laminar/B747/gear/air_ground/ng_compressed", "op": "==", "value": 1 },
    { "do": "check", "note": "PSEU：地上ではレバーをロック（FCOM p.1512）", "dref": "laminar/B747/gear/air_ground/lever_unlock", "op": "==", "value": 0 },

    { "do": "mark", "note": "BUS TIE 2 OFF" },
    { "do": "switch", "note": "BUS TIE 2 OFF", "dref": "laminar/B747/button_switch/position[19]", "value": 0, "cmd": "laminar/B747/button_switch/elec_bus_tie_2" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "BTB 2 開（FCOM p.785）", "dref": "laminar/B747/electrical/breaker/btb[1]", "op": "==", "value": 0 },
    { "do": "check", "note": "DCIR 2 開（FCOM p.819）", "dref": "laminar/B747/electrical/breaker/dcir[1]", "op": "==", "value": 0 },
    { "do": "check", "note": "ISLN 灯", "dref": "laminar/B747/electrical/light/isln[1]", "op": "==", "value": 1 },
    { "do": "check", "note": "ELEC BUS ISLN 2（FCOM p.821）", "dref": "laminar/B747/CAS/advisory_status[93]", "op": "==", "value": 1 },
    { "do": "check", "note": "AC 2 は自分の IDG で生きている", "dref": "laminar/B747/electrical/bus/ac[1]", "op": "==", "value": 1 },
    { "do": "view", "name": "panel" },
    { "do": "cas", "note": "BUS TIE 2 OFF" },
    { "do": "switch", "note": "BUS TIE 2 AUTO", "dref": "laminar/B747/button_switch/position[19]", "value": 1, "cmd": "laminar/B747/button_switch/elec_bus_tie_2" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "BTB 2 閉", "dref": "laminar/B747/electrical/breaker/btb[1]", "op": "==", "value": 1 },

    { "do": "mark", "note": "GEN CONT 3 OFF" },
    { "do": "switch", "note": "GEN CONT 3 OFF", "dref": "laminar/B747/button_switch/position[24]", "value": 0, "cmd": "laminar/B747/button_switch/elec_gen_ctrl_3" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "GCB 3 開（FCOM p.786）", "dref": "laminar/B747/electrical/breaker/gcb[2]", "op": "==", "value": 0 },
    { "do": "check", "note": "AC 3 は同期バスから（FCOM p.798）", "dref": "laminar/B747/electrical/bus/ac[2]", "op": "==", "value": 1 },
    { "do": "check", "note": "GEN CONT OFF 灯", "dref": "laminar/B747/electrical/light/gen_off[2]", "op": "==", "value": 1 },
    { "do": "check", "note": "ELEC GEN OFF 3（advisory、FCOM p.822）", "dref": "laminar/B747/CAS/advisory_status[102]", "op": "==", "value": 1 },
    { "do": "check", "note": "X-Plane の発電機 3 も切れる", "dref": "sim/cockpit2/electrical/generator_on[2]", "op": "==", "value": 0 },
    { "do": "cas", "note": "GEN CONT 3 OFF" },
    { "do": "shot", "name": "panel_gen_cont_3_off" },
    { "do": "switch", "note": "GEN CONT 3 ON", "dref": "laminar/B747/button_switch/position[24]", "value": 1, "cmd": "laminar/B747/button_switch/elec_gen_ctrl_3" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "GCB 3 閉", "dref": "laminar/B747/electrical/breaker/gcb[2]", "op": "==", "value": 1 },

    { "do": "mark", "note": "L UTILITY OFF" },
    { "do": "switch", "note": "L UTILITY OFF", "dref": "laminar/B747/button_switch/position[11]", "value": 0, "cmd": "laminar/B747/button_switch/elec_util_L" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "utility 1 非通電（FCOM p.781）", "dref": "laminar/B747/electrical/bus/utility[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "UTILITY OFF 灯", "dref": "laminar/B747/electrical/light/util_off[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "ELEC UTIL BUS L（FCOM p.822）", "dref": "laminar/B747/CAS/advisory_status[105]", "op": "==", "value": 1 },
    { "do": "switch", "note": "L UTILITY ON", "dref": "laminar/B747/button_switch/position[11]", "value": 1, "cmd": "laminar/B747/button_switch/elec_util_L" },

    { "do": "mark", "note": "STANDBY POWER OFF" },
    { "do": "switch", "note": "STANDBY POWER OFF", "dref": "laminar/B747/electrical/standby_power/sel_dial_pos", "value": 0,
      "cmd": "laminar/B747/electrical/standby_power/sel_dial_up", "cmd_down": "laminar/B747/electrical/standby_power/sel_dial_dn" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "main standby bus 非通電（FCOM p.780）", "dref": "laminar/B747/electrical/bus/stby_main", "op": "==", "value": 0 },
    { "do": "check", "note": "APU standby bus 非通電（FCOM p.780）", "dref": "laminar/B747/electrical/bus/stby_apu", "op": "==", "value": 0 },
    { "do": "check", "note": ">STBY BUS MAIN（FCOM p.823）", "dref": "laminar/B747/CAS/advisory_status[277]", "op": "==", "value": 1 },
    { "do": "check", "note": ">STBY BUS APU（FCOM p.823）", "dref": "laminar/B747/CAS/advisory_status[276]", "op": "==", "value": 1 },
    { "do": "check", "note": "機長の PFD・ND は APU standby bus（FCOM p.804）", "dref": "laminar/B747/electrical/capt_display_power", "op": "==", "value": 6 },
    { "do": "shot", "name": "panel_stby_off" },
    { "do": "switch", "note": "STANDBY POWER AUTO", "dref": "laminar/B747/electrical/standby_power/sel_dial_pos", "value": 1,
      "cmd": "laminar/B747/electrical/standby_power/sel_dial_up", "cmd_down": "laminar/B747/electrical/standby_power/sel_dial_dn" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "機長の表示が戻る", "dref": "laminar/B747/electrical/capt_display_power", "op": "==", "value": 0 },

    { "do": "mark", "note": "APU 始動" },
    { "do": "switch", "note": "APU selector ON", "dref": "laminar/B747/electrical/apu/sel_dial_pos", "value": 1,
      "cmd": "laminar/B747/electrical/apu/sel_dial_up", "cmd_down": "laminar/B747/electrical/apu/sel_dial_dn" },
    { "do": "wait", "note": "APU 吸気ドア", "dref": "laminar/B747/electrical/apu_inlet_door", "op": ">=", "value": 0.2, "timeout": 60 },
    { "do": "switch", "note": "APU selector START", "dref": "laminar/B747/electrical/apu/sel_dial_pos", "value": 2,
      "cmd": "laminar/B747/electrical/apu/sel_dial_up", "cmd_down": "laminar/B747/electrical/apu/sel_dial_dn" },
    { "do": "wait", "note": "APU N1 95 %", "dref": "sim/cockpit2/electrical/APU_N1_percent", "op": ">=", "value": 95, "timeout": 150 },
    { "do": "check", "note": "APU GEN AVAIL 灯（FCOM p.783）", "dref": "laminar/B747/electrical/light/apu_avail[0]", "op": "==", "value": 1 },
    { "do": "switch", "note": "APU GEN 1 ON", "dref": "laminar/B747/electrical/apu_pwr1_on", "value": 1, "cmd": "laminar/B747/button_switch/elec_apu_gen_1" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "IDG 1 が外れる（FCOM p.797）", "dref": "laminar/B747/electrical/breaker/gcb[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "IDG 2 が外れる", "dref": "laminar/B747/electrical/breaker/gcb[1]", "op": "==", "value": 0 },
    { "do": "check", "note": "IDG 3 は残る（APU 2 も使えるので分割：LH24 p.123）", "dref": "laminar/B747/electrical/breaker/gcb[2]", "op": "==", "value": 1 },
    { "do": "check", "note": "SSB 開", "dref": "laminar/B747/electrical/breaker/ssb", "op": "==", "value": 0 },
    { "do": "check", "note": "AC 1 は APU 1 から", "dref": "laminar/B747/electrical/bus/ac[0]", "op": "==", "value": 1 },
    { "do": "cas", "note": "APU GEN 1 ON（エンジン運転中）" },
    { "do": "shot", "name": "panel_apu_gen_1" },
    { "do": "switch", "note": "APU GEN 1 OFF", "dref": "laminar/B747/electrical/apu_pwr1_on", "value": 0, "cmd": "laminar/B747/button_switch/elec_apu_gen_1" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "IDG 1 が戻る", "dref": "laminar/B747/electrical/breaker/gcb[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "SSB が閉じる", "dref": "laminar/B747/electrical/breaker/ssb", "op": "==", "value": 1 },

    { "do": "mark", "note": "DRIVE DISC 4" },
    { "do": "cmd", "note": "DRIVE DISC 4 を押す（地上の整備でしか戻らない）", "name": "laminar/B747/button_switch/elec_drive_disc_4" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "IDG 4 切り離し（FCOM p.785）", "dref": "laminar/B747/electrical/idg_connected[3]", "op": "==", "value": 0 },
    { "do": "check", "note": "GCB 4 開", "dref": "laminar/B747/electrical/breaker/gcb[3]", "op": "==", "value": 0 },
    { "do": "check", "note": ">DRIVE DISC 4（FCOM p.821）", "dref": "laminar/B747/CAS/advisory_status[86]", "op": "==", "value": 1 },
    { "do": "check", "note": "DRIVE 灯", "dref": "laminar/B747/electrical/light/drive[3]", "op": "==", "value": 1 },
    { "do": "check", "note": "AC 4 は同期バスから", "dref": "laminar/B747/electrical/bus/ac[3]", "op": "==", "value": 1 },
    { "do": "cas", "note": "DRIVE DISC 4" },
    { "do": "shot", "name": "panel_drive_disc_4" },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
