{
  "name": "s04_hydraulics",
  "description": "油圧（1-4）の X-Plane での確認。エンジン運転中の地上で開始し、ENGINE pump 1 を OFF（demand pump 1 が AUTO で引き継ぐ）、続けて DEMAND 1 を OFF（系統 1 の圧が抜ける）にして、圧・P5 の灯・EICAS・synoptic を見る。期待値は FCOM 13.10-13.30 と ATA29_32 の HYDIM の論理（notes/ATA-29.md）。",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "sleep", "seconds": 8 },
    { "do": "snapshot", "note": "開始直後", "drefs": [
      "sim/aircraft/view/acf_relative_path",
      "laminar/B747/hydraulics/pressure_1", "laminar/B747/hydraulics/pressure_2", "laminar/B747/hydraulics/pressure_3", "laminar/B747/hydraulics/pressure_4",
      "laminar/B747/hydraulics/edp_pressure_1", "laminar/B747/hydraulics/dem_pressure_1", "laminar/B747/hydraulics/aux_pressure",
      "laminar/B747/hydraulics/dmd_pump/sel_dial_pos[0]", "laminar/B747/hydraulics/dmd_pump/sel_dial_pos[3]",
      "laminar/B747/hydraulics/indicators/hydraulic_pressure_1_2_4", "laminar/B747/hydraulics/temp_1", "laminar/B747/hydraulics/res_1",
      "laminar/B747/air/duct_pressure_L", "laminar/B747/air/duct_pressure_R", "laminar/B747/gear/air_ground/alt_air" ] },
    { "do": "cas", "note": "開始直後" },
    { "do": "check", "note": "系統 1 は約 3000 psi（ATA22 p.6）", "dref": "laminar/B747/hydraulics/pressure_1", "op": ">", "value": 2800 },
    { "do": "check", "note": "系統 4", "dref": "laminar/B747/hydraulics/pressure_4", "op": ">", "value": 2800 },
    { "do": "check", "note": "ENGINE PRESS 1 消灯", "dref": "laminar/B747/hydraulics/light/eng_press[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "DEMAND PRESS 1 消灯（AUTO で待機）", "dref": "laminar/B747/hydraulics/light/dem_press[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "SYS FAULT 1 消灯", "dref": "laminar/B747/hydraulics/light/sys_fault[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "HYD PRESS SYS 1 なし", "dref": "laminar/B747/CAS/caution_status[40]", "op": "==", "value": 0 },
    { "do": "check", "note": ">BRAKE SOURCE なし", "dref": "laminar/B747/CAS/caution_status[9]", "op": "==", "value": 0 },
    { "do": "check", "note": "brake accumulator（系統 4 が充圧。ATA29_32 p.408）", "dref": "laminar/B747/hydraulics/indicators/hydraulic_pressure_1_2_4", "op": ">", "value": 2500 },
    { "do": "check", "note": "synoptic の SOV 開・EDP ON", "dref": "laminar/B747/hydraulics/valve_1", "op": "==", "value": 1 },

    { "do": "mark", "note": "ENGINE pump 1 OFF" },
    { "do": "switch", "note": "ENGINE pump 1 OFF", "dref": "laminar/B747/button_switch/position[30]", "value": 0, "cmd": "laminar/B747/button_switch/hyd_pump_1" },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "ENGINE PRESS 1 点灯（EDP 圧 < 1400 が 2 秒。ATA29_32 p.141）", "dref": "laminar/B747/hydraulics/light/eng_press[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "HYD PRESS ENG 1（FCOM p.1495）", "dref": "laminar/B747/CAS/advisory_status[210]", "op": "==", "value": 1 },
    { "do": "check", "note": "demand pump 1（ADP）が AUTO で引き継ぐ（0.3 秒。p.141）", "dref": "laminar/B747/hydraulics/dem_pressure_1", "op": ">", "value": 2800 },
    { "do": "check", "note": "系統 1 の圧は保たれる", "dref": "laminar/B747/hydraulics/pressure_1", "op": ">", "value": 2800 },
    { "do": "check", "note": "synoptic は EDP OFF", "dref": "laminar/B747/hydraulics/valve_1", "op": "==", "value": 0 },
    { "do": "view", "name": "overhead" },
    { "do": "shot", "name": "overhead_edp1_off" },
    { "do": "cas", "note": "ENGINE pump 1 OFF" },

    { "do": "mark", "note": "DEMAND 1 OFF" },
    { "do": "switch", "note": "DEMAND 1 OFF", "dref": "laminar/B747/hydraulics/dmd_pump/sel_dial_pos[0]", "value": 0, "cmd": "laminar/B747/hydraulics/sel_dial/dmd_pump_01_dn" },
    { "do": "wait", "note": "系統 1 の圧が抜ける（減衰の速さは推定）", "dref": "laminar/B747/hydraulics/pressure_1", "op": "<", "value": 1200, "timeout": 20 },
    { "do": "wait", "note": "HYD PRESS SYS 1（< 1200 psi が 2 秒。FCOM p.1495）", "dref": "laminar/B747/CAS/caution_status[40]", "op": "==", "value": 1, "timeout": 5 },
    { "do": "check", "note": "SYS FAULT 1 点灯", "dref": "laminar/B747/hydraulics/light/sys_fault[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "DEMAND PRESS 1 点灯（セレクタ OFF）", "dref": "laminar/B747/hydraulics/light/dem_press[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "HYD PRESS ENG 1 は HYD PRESS SYS 1 で抑止（FCOM p.1582）", "dref": "laminar/B747/CAS/advisory_status[210]", "op": "==", "value": 0 },
    { "do": "check", "note": "HYD PRESS DEM 1 も抑止", "dref": "laminar/B747/CAS/advisory_status[206]", "op": "==", "value": 0 },
    { "do": "check", "note": "ブレーキは系統 4 のまま", "dref": "laminar/B747/CAS/caution_status[9]", "op": "==", "value": 0 },
    { "do": "shot", "name": "overhead_sys1_lost" },
    { "do": "cmd", "note": "HYD synoptic", "name": "laminar/B747/dsp/hyd_switch", "duration": 0.2 },
    { "do": "view", "name": "panel" },
    { "do": "shot", "name": "panel_hyd_synoptic" },
    { "do": "cas", "note": "DEMAND 1 OFF" },

    { "do": "mark", "note": "復旧" },
    { "do": "switch", "note": "DEMAND 1 AUTO", "dref": "laminar/B747/hydraulics/dmd_pump/sel_dial_pos[0]", "value": 1, "cmd": "laminar/B747/hydraulics/sel_dial/dmd_pump_01_up" },
    { "do": "switch", "note": "ENGINE pump 1 ON", "dref": "laminar/B747/button_switch/position[30]", "value": 1, "cmd": "laminar/B747/button_switch/hyd_pump_1" },
    { "do": "wait", "note": "系統 1 が戻る", "dref": "laminar/B747/hydraulics/pressure_1", "op": ">", "value": 2800, "timeout": 10 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "HYD PRESS SYS 1 が消える", "dref": "laminar/B747/CAS/caution_status[40]", "op": "==", "value": 0 },
    { "do": "check", "note": "ENGINE PRESS 1 消灯", "dref": "laminar/B747/hydraulics/light/eng_press[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "SYS FAULT 1 消灯", "dref": "laminar/B747/hydraulics/light/sys_fault[0]", "op": "==", "value": 0 },
    { "do": "cmd", "note": "synoptic を消す", "name": "laminar/B747/dsp/hyd_switch", "duration": 0.2 },
    { "do": "cas", "note": "復旧後" },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
