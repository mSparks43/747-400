{
  "name": "s00_baseline_start",
  "description": "作り直し前の基準（ベースライン）。駐機中の電源投入、APU 始動、4 発のエンジン始動（4→3→2→1）を今の機体のまま回して記録する。手順の順番は FCOM NP.21・SP.6（notes/FCTM.md §2.1・§2.2）。判定はゆるく、主に記録のため。",
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": false } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "snapshot", "note": "初期状態", "drefs": [
      "laminar/B747/engines/type", "sim/aircraft/view/acf_relative_path",
      "laminar/B747/button_switch/position[13]", "laminar/B747/electrical/standby_power/sel_dial_pos",
      "laminar/B747/electrical/apu/sel_dial_pos", "sim/cockpit2/electrical/bus_volts[0]",
      "laminar/B747/electrical/bus1hot", "laminar/B747/electrical/bus2hot",
      "laminar/B747/electrical/bus3hot", "laminar/B747/electrical/bus4hot",
      "laminar/B747/fuel/fuel_control/toggle_sw_pos[0]", "laminar/B747/fuel/fuel_control/toggle_sw_pos[1]",
      "laminar/B747/fuel/fuel_control/toggle_sw_pos[2]", "laminar/B747/fuel/fuel_control/toggle_sw_pos[3]",
      "sim/flightmodel/weight/m_fuel_total", "sim/flightmodel/weight/m_total" ] },
    { "do": "cas", "note": "初期状態" },
    { "do": "view", "name": "panel" },
    { "do": "shot", "name": "panel_initial" },

    { "do": "switch", "note": "BATTERY ON", "cite": "FCOM p.179 (SP.6.1)",
      "dref": "laminar/B747/button_switch/position[13]", "value": 1, "cmd": "laminar/B747/button_switch/elec_battery" },
    { "do": "switch", "note": "STANDBY POWER AUTO", "cite": "FCOM p.179 (SP.6.1)",
      "dref": "laminar/B747/electrical/standby_power/sel_dial_pos", "value": 1,
      "cmd": "laminar/B747/electrical/standby_power/sel_dial_up", "cmd_down": "laminar/B747/electrical/standby_power/sel_dial_dn" },
    { "do": "switch", "note": "FUEL CONTROL 1 CUTOFF", "cite": "FCOM p.113 (NP.21.19)",
      "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[0]", "value": 0, "cmd": "laminar/B747/fuel/fuel_control_1/toggle_switch" },
    { "do": "switch", "note": "FUEL CONTROL 2 CUTOFF",
      "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[1]", "value": 0, "cmd": "laminar/B747/fuel/fuel_control_2/toggle_switch" },
    { "do": "switch", "note": "FUEL CONTROL 3 CUTOFF",
      "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[2]", "value": 0, "cmd": "laminar/B747/fuel/fuel_control_3/toggle_switch" },
    { "do": "switch", "note": "FUEL CONTROL 4 CUTOFF",
      "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[3]", "value": 0, "cmd": "laminar/B747/fuel/fuel_control_4/toggle_switch" },
    { "do": "cas", "note": "BATTERY・STANDBY POWER の後" },

    { "do": "switch", "note": "APU selector ON（今の実装は ON で吸気ドアを開けてから START が要る。FCOM の START→ON では始動しない：APU-13）", "cite": "FCOM p.180 (SP.6.2)",
      "dref": "laminar/B747/electrical/apu/sel_dial_pos", "value": 1,
      "cmd": "laminar/B747/electrical/apu/sel_dial_up", "cmd_down": "laminar/B747/electrical/apu/sel_dial_dn" },
    { "do": "wait", "note": "APU 吸気ドアが開く（今の実装は 13 % で始動を許す）",
      "dref": "laminar/B747/electrical/apu_inlet_door", "op": ">=", "value": 0.2, "timeout": 60 },
    { "do": "switch", "note": "APU selector START（6 秒後にばねで ON に戻る実装）", "cite": "FCOM p.180 (SP.6.2)",
      "dref": "laminar/B747/electrical/apu/sel_dial_pos", "value": 2,
      "cmd": "laminar/B747/electrical/apu/sel_dial_up", "cmd_down": "laminar/B747/electrical/apu/sel_dial_dn" },
    { "do": "wait", "note": "selector が ON に戻る", "level": "warn",
      "dref": "laminar/B747/electrical/apu/sel_dial_pos", "op": "==", "value": 1, "timeout": 15 },
    { "do": "wait", "note": "APU N1 95 % 以上（START から 120 秒以内は推定）", "cite": "FCOM p.897 (7.30.3)",
      "dref": "sim/cockpit2/electrical/APU_N1_percent", "op": ">=", "value": 95, "timeout": 150 },
    { "do": "wait", "note": "APU GEN 1 AVAIL", "cite": "FCOM p.180 (SP.6.2)",
      "dref": "laminar/B747/electrical/apu_pwr1_avail", "op": "==", "value": 1, "timeout": 30 },
    { "do": "cas", "note": "APU 始動後" },

    { "do": "switch", "note": "APU GEN 1 ON", "cite": "FCOM p.180 (SP.6.2)",
      "dref": "laminar/B747/electrical/apu_pwr1_on", "value": 1, "cmd": "laminar/B747/button_switch/elec_apu_gen_1" },
    { "do": "switch", "note": "APU GEN 2 ON", "cite": "FCOM p.180 (SP.6.2)",
      "dref": "laminar/B747/electrical/apu_pwr2_on", "value": 1, "cmd": "laminar/B747/button_switch/elec_apu_gen_2" },
    { "do": "wait", "note": "AC BUS 1 通電", "dref": "laminar/B747/electrical/bus1hot", "op": "==", "value": 1, "timeout": 15 },
    { "do": "check", "note": "AC BUS 2 通電", "dref": "laminar/B747/electrical/bus2hot", "op": "==", "value": 1 },
    { "do": "check", "note": "AC BUS 3 通電", "dref": "laminar/B747/electrical/bus3hot", "op": "==", "value": 1 },
    { "do": "check", "note": "AC BUS 4 通電", "dref": "laminar/B747/electrical/bus4hot", "op": "==", "value": 1 },
    { "do": "cas", "note": "APU GEN 投入後" },
    { "do": "shot", "name": "panel_apu_gen" },

    { "do": "switch", "note": "APU BLEED ON", "cite": "FCOM p.109 (NP.21.15)",
      "dref": "laminar/B747/button_switch/position[81]", "value": 1, "cmd": "laminar/B747/button_switch/bleed_air_vlv_apu" },
    { "do": "switch", "note": "ISOLATION L ON", "dref": "laminar/B747/button_switch/position[75]", "value": 1, "cmd": "laminar/B747/button_switch/bleed_air_isln_vlv_L" },
    { "do": "switch", "note": "ISOLATION R ON", "dref": "laminar/B747/button_switch/position[76]", "value": 1, "cmd": "laminar/B747/button_switch/bleed_air_isln_vlv_R" },
    { "do": "switch", "note": "ENGINE BLEED 1 ON", "dref": "laminar/B747/button_switch/position[77]", "value": 1, "cmd": "laminar/B747/button_switch/bleed_air_vlv_engine_1" },
    { "do": "switch", "note": "ENGINE BLEED 2 ON", "dref": "laminar/B747/button_switch/position[78]", "value": 1, "cmd": "laminar/B747/button_switch/bleed_air_vlv_engine_2" },
    { "do": "switch", "note": "ENGINE BLEED 3 ON", "dref": "laminar/B747/button_switch/position[79]", "value": 1, "cmd": "laminar/B747/button_switch/bleed_air_vlv_engine_3" },
    { "do": "switch", "note": "ENGINE BLEED 4 ON", "dref": "laminar/B747/button_switch/position[80]", "value": 1, "cmd": "laminar/B747/button_switch/bleed_air_vlv_engine_4" },
    { "do": "switch", "note": "PACK 1 OFF（始動の前）", "cite": "FCOM p.124 (NP.21.30)",
      "dref": "laminar/B747/air/pack_ctrl/sel_dial_pos[0]", "value": 0,
      "cmd": "laminar/B747/air/pack_ctrl_01/sel_dial_up", "cmd_down": "laminar/B747/air/pack_ctrl_01/sel_dial_dn" },
    { "do": "switch", "note": "PACK 2 OFF",
      "dref": "laminar/B747/air/pack_ctrl/sel_dial_pos[1]", "value": 0,
      "cmd": "laminar/B747/air/pack_ctrl_02/sel_dial_up", "cmd_down": "laminar/B747/air/pack_ctrl_02/sel_dial_dn" },
    { "do": "switch", "note": "PACK 3 OFF",
      "dref": "laminar/B747/air/pack_ctrl/sel_dial_pos[2]", "value": 0,
      "cmd": "laminar/B747/air/pack_ctrl_03/sel_dial_up", "cmd_down": "laminar/B747/air/pack_ctrl_03/sel_dial_dn" },

    { "do": "switch", "note": "MAIN FWD 1 ON", "cite": "FCOM p.119 (NP.21.25)", "dref": "laminar/B747/button_switch/position[56]", "value": 1, "cmd": "laminar/B747/button_switch/fuel_main_pump_fwd_1" },
    { "do": "switch", "note": "MAIN FWD 2 ON", "dref": "laminar/B747/button_switch/position[57]", "value": 1, "cmd": "laminar/B747/button_switch/fuel_main_pump_fwd_2" },
    { "do": "switch", "note": "MAIN FWD 3 ON", "dref": "laminar/B747/button_switch/position[58]", "value": 1, "cmd": "laminar/B747/button_switch/fuel_main_pump_fwd_3" },
    { "do": "switch", "note": "MAIN FWD 4 ON", "dref": "laminar/B747/button_switch/position[59]", "value": 1, "cmd": "laminar/B747/button_switch/fuel_main_pump_fwd_4" },
    { "do": "switch", "note": "MAIN AFT 1 ON", "dref": "laminar/B747/button_switch/position[60]", "value": 1, "cmd": "laminar/B747/button_switch/fuel_main_pump_aft_1" },
    { "do": "switch", "note": "MAIN AFT 2 ON", "dref": "laminar/B747/button_switch/position[61]", "value": 1, "cmd": "laminar/B747/button_switch/fuel_main_pump_aft_2" },
    { "do": "switch", "note": "MAIN AFT 3 ON", "dref": "laminar/B747/button_switch/position[62]", "value": 1, "cmd": "laminar/B747/button_switch/fuel_main_pump_aft_3" },
    { "do": "switch", "note": "MAIN AFT 4 ON", "dref": "laminar/B747/button_switch/position[63]", "value": 1, "cmd": "laminar/B747/button_switch/fuel_main_pump_aft_4" },
    { "do": "sleep", "seconds": 3 },
    { "do": "snapshot", "note": "始動前のダクト圧と燃料", "drefs": [
      "laminar/B747/air/duct_pressure_L", "laminar/B747/air/duct_pressure_R", "laminar/B747/air/duct_pressure_C",
      "sim/flightmodel/weight/m_fuel_total" ] },
    { "do": "cas", "note": "始動前" },

    { "do": "mark", "note": "ENG 4 始動" },
    { "do": "switch", "note": "START 4", "cite": "FCOM p.879 (7.20.9)",
      "dref": "laminar/B747/toggle_switch/position[19]", "value": 1, "cmd": "laminar/B747/toggle_switch/engine_start4" },
    { "do": "wait", "note": "N2 20 %（燃料を入れる目安。推定）", "dref": "sim/flightmodel/engine/ENGN_N2_[3]", "op": ">=", "value": 20, "timeout": 60 },
    { "do": "switch", "note": "FUEL CONTROL 4 RUN", "cite": "FCOM p.124 (NP.21.30)",
      "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[3]", "value": 1, "cmd": "laminar/B747/fuel/fuel_control_4/toggle_switch" },
    { "do": "wait", "note": "N2 60 % 以上（idle 付近。推定）", "dref": "sim/flightmodel/engine/ENGN_N2_[3]", "op": ">=", "value": 60, "timeout": 120 },
    { "do": "wait", "note": "START 4 が戻る（N2 50 % で starter cutout）", "cite": "FCOM p.879 (7.20.9)", "level": "warn",
      "dref": "laminar/B747/toggle_switch/position[19]", "op": "==", "value": 0, "timeout": 30 },

    { "do": "mark", "note": "ENG 3 始動" },
    { "do": "switch", "note": "START 3", "dref": "laminar/B747/toggle_switch/position[18]", "value": 1, "cmd": "laminar/B747/toggle_switch/engine_start3" },
    { "do": "wait", "note": "N2 20 %", "dref": "sim/flightmodel/engine/ENGN_N2_[2]", "op": ">=", "value": 20, "timeout": 60 },
    { "do": "switch", "note": "FUEL CONTROL 3 RUN", "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[2]", "value": 1, "cmd": "laminar/B747/fuel/fuel_control_3/toggle_switch" },
    { "do": "wait", "note": "N2 60 % 以上", "dref": "sim/flightmodel/engine/ENGN_N2_[2]", "op": ">=", "value": 60, "timeout": 120 },
    { "do": "wait", "note": "START 3 が戻る", "level": "warn", "dref": "laminar/B747/toggle_switch/position[18]", "op": "==", "value": 0, "timeout": 30 },

    { "do": "mark", "note": "ENG 2 始動" },
    { "do": "switch", "note": "START 2", "dref": "laminar/B747/toggle_switch/position[17]", "value": 1, "cmd": "laminar/B747/toggle_switch/engine_start2" },
    { "do": "wait", "note": "N2 20 %", "dref": "sim/flightmodel/engine/ENGN_N2_[1]", "op": ">=", "value": 20, "timeout": 60 },
    { "do": "switch", "note": "FUEL CONTROL 2 RUN", "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[1]", "value": 1, "cmd": "laminar/B747/fuel/fuel_control_2/toggle_switch" },
    { "do": "wait", "note": "N2 60 % 以上", "dref": "sim/flightmodel/engine/ENGN_N2_[1]", "op": ">=", "value": 60, "timeout": 120 },
    { "do": "wait", "note": "START 2 が戻る", "level": "warn", "dref": "laminar/B747/toggle_switch/position[17]", "op": "==", "value": 0, "timeout": 30 },

    { "do": "mark", "note": "ENG 1 始動" },
    { "do": "switch", "note": "START 1", "dref": "laminar/B747/toggle_switch/position[16]", "value": 1, "cmd": "laminar/B747/toggle_switch/engine_start1" },
    { "do": "wait", "note": "N2 20 %", "dref": "sim/flightmodel/engine/ENGN_N2_[0]", "op": ">=", "value": 20, "timeout": 60 },
    { "do": "switch", "note": "FUEL CONTROL 1 RUN", "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[0]", "value": 1, "cmd": "laminar/B747/fuel/fuel_control_1/toggle_switch" },
    { "do": "wait", "note": "N2 60 % 以上", "dref": "sim/flightmodel/engine/ENGN_N2_[0]", "op": ">=", "value": 60, "timeout": 120 },
    { "do": "wait", "note": "START 1 が戻る", "level": "warn", "dref": "laminar/B747/toggle_switch/position[16]", "op": "==", "value": 0, "timeout": 30 },

    { "do": "sleep", "seconds": 20 },
    { "do": "snapshot", "note": "4 発 idle", "drefs": [
      "sim/flightmodel/engine/ENGN_N1_[0]", "sim/flightmodel/engine/ENGN_N1_[1]", "sim/flightmodel/engine/ENGN_N1_[2]", "sim/flightmodel/engine/ENGN_N1_[3]",
      "sim/flightmodel/engine/ENGN_N2_[0]", "sim/flightmodel/engine/ENGN_N2_[1]", "sim/flightmodel/engine/ENGN_N2_[2]", "sim/flightmodel/engine/ENGN_N2_[3]",
      "sim/flightmodel/engine/ENGN_EGT_c[0]", "sim/flightmodel/engine/ENGN_EGT_c[1]", "sim/flightmodel/engine/ENGN_EGT_c[2]", "sim/flightmodel/engine/ENGN_EGT_c[3]",
      "sim/flightmodel/engine/ENGN_EPR[0]", "sim/flightmodel/engine/ENGN_EPR[1]", "sim/flightmodel/engine/ENGN_EPR[2]", "sim/flightmodel/engine/ENGN_EPR[3]",
      "sim/flightmodel/engine/ENGN_FF_[0]", "sim/flightmodel/engine/ENGN_FF_[1]", "sim/flightmodel/engine/ENGN_FF_[2]", "sim/flightmodel/engine/ENGN_FF_[3]" ] },
    { "do": "cas", "note": "4 発始動後" },
    { "do": "view", "name": "panel" },
    { "do": "shot", "name": "panel_after_start" },
    { "do": "view", "name": "forward" },
    { "do": "shot", "name": "after_start" },
    { "do": "record_stop" }
  ]
}
