{
  "name": "s01_ap_basic",
  "description": "自動操縦の基本（作り直し前の記録と、R-1 の切り出しの確認）。10,000 ft・250 kt 付近で空中から始め（空中開始では A/P が既に入っている）、A/P CMD L・ALT HOLD・HDG SEL（今の方位）で 60 秒保ち、HDG SEL で 010 へ旋回し、V/S +1,000 fpm で 11,000 ft まで上がって捕捉する。今のコードに HDG HOLD は無い（コマンドがコメントアウトされている）。判定はゆるく、主に記録のため（数値の許容幅は推定）。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 3048, "heading_true": 340, "speed_in_meters_per_second": 150 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "sleep", "seconds": 30, "note": "空中開始の揺れが収まるのを待つ" },
    { "do": "snapshot", "note": "開始直後", "drefs": [
      "sim/aircraft/view/acf_relative_path", "laminar/B747/engines/type",
      "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/cockpit2/gauges/indicators/airspeed_kts_pilot",
      "sim/cockpit2/gauges/indicators/heading_AHARS_deg_mag_pilot", "sim/flightmodel/position/phi",
      "laminar/B747/autopilot/servos_on", "laminar/B747/autopilot/FMA/active_pitch_mode", "laminar/B747/autopilot/FMA/active_roll_mode",
      "laminar/B747/autothrottle/armed", "laminar/B747/hydraulics/pressure_1", "laminar/B747/hydraulics/pressure_4",
      "sim/flightmodel/engine/ENGN_N1_[0]", "sim/cockpit2/engine/actuators/throttle_ratio_all" ] },
    { "do": "cas", "note": "開始直後" },
    { "do": "check", "note": "空中開始の速度（200 kt 以上でなければ開始の失敗）", "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "op": ">=", "value": 200 },
    { "do": "check", "note": "PSEU：air（ATA29_32 p.322）", "dref": "laminar/B747/gear/air_ground/pri_air", "op": "==", "value": 1 },
    { "do": "check", "note": "PSEU：地上ではない", "dref": "laminar/B747/gear/air_ground/pri_gnd", "op": "==", "value": 0 },
    { "do": "check", "note": "電源の BCU も air mode（LH24 p.66）", "dref": "laminar/B747/electrical/air_mode", "op": "==", "value": 1 },
    { "do": "check", "note": "空中では APU GEN の AVAIL 灯が消える（FCOM p.783）", "dref": "laminar/B747/electrical/light/apu_avail[0]", "op": "==", "value": 0 },

    { "do": "set", "note": "MCP 速度 250 kt（MCP の IAS 窓。A/P がこれを X-Plane の速度ダイヤルに写す）", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 250 },
    { "do": "set", "note": "MCP 高度 10,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 10000 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボが入る", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "set", "note": "MCP 方位 347（空中開始の磁方位）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 347 },
    { "do": "cmd", "note": "HDG SEL（HDG HOLD の代わり）", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "sleep", "seconds": 3 },
    { "do": "snapshot", "note": "モード", "drefs": [
      "laminar/B747/autopilot/FMA/active_pitch_mode", "laminar/B747/autopilot/FMA/active_roll_mode",
      "laminar/B747/autopilot/FMA/autothrottle_mode", "laminar/B747/autopilot/servos_on",
      "laminar/B747/autopilot/altitude_dial_ft", "laminar/B747/autopilot/heading/degrees" ] },
    { "do": "mark", "note": "ALT HOLD・HDG SEL で保持" },
    { "do": "sleep", "seconds": 60 },
    { "do": "check", "note": "高度を保つ（±200 ft、推定）", "level": "warn",
      "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "between", "value": [9700, 10500] },
    { "do": "check", "note": "翼を水平に保つ（±5°、推定）", "level": "warn",
      "dref": "sim/flightmodel/position/phi", "op": "between", "value": [-5, 5] },
    { "do": "check", "note": "速度（240〜260 kt、推定）", "level": "warn",
      "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "op": "between", "value": [235, 265] },
    { "do": "view", "name": "panel" },
    { "do": "shot", "name": "panel_alt_hold" },

    { "do": "mark", "note": "HDG SEL 010" },
    { "do": "set", "note": "MCP 方位 010", "dref": "laminar/B747/autopilot/heading/degrees", "value": 10 },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "wait", "note": "旋回に入る（バンク 10° 以上）", "level": "warn",
      "dref": "sim/flightmodel/position/phi", "op": ">=", "value": 10, "timeout": 30 },
    { "do": "wait", "note": "方位 010 付近に達する", "level": "warn",
      "dref": "sim/cockpit2/gauges/indicators/heading_AHARS_deg_mag_pilot", "op": "between", "value": [5, 15], "timeout": 120 },
    { "do": "sleep", "seconds": 20 },
    { "do": "check", "note": "旋回の後、翼を水平に戻す（±5°、推定）", "level": "warn",
      "dref": "sim/flightmodel/position/phi", "op": "between", "value": [-5, 5] },

    { "do": "mark", "note": "V/S +1000 で 11,000 ft へ" },
    { "do": "set", "note": "MCP 高度 11,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 11000 },
    { "do": "cmd", "note": "V/S", "name": "laminar/B747/autopilot/button_switch/vs_mode" },
    { "do": "set", "note": "V/S 1,000 fpm（V/S を押すと 0 に戻るので、押した後に合わせる）", "dref": "sim/cockpit2/autopilot/vvi_dial_fpm", "value": 1000 },
    { "do": "wait", "note": "上昇に入る（+500 fpm 以上）", "level": "warn",
      "dref": "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "op": ">=", "value": 500, "timeout": 30 },
    { "do": "wait", "note": "11,000 ft 付近で捕捉する", "level": "warn",
      "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "between", "value": [10900, 11100], "timeout": 150 },
    { "do": "sleep", "seconds": 30 },
    { "do": "check", "note": "11,000 ft を保つ（±150 ft、推定）", "level": "warn",
      "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "between", "value": [10850, 11150] },
    { "do": "snapshot", "note": "終わり", "drefs": [
      "laminar/B747/autopilot/FMA/active_pitch_mode", "laminar/B747/autopilot/FMA/active_roll_mode",
      "laminar/B747/autopilot/FMA/autothrottle_mode", "sim/cockpit2/gauges/indicators/airspeed_kts_pilot",
      "sim/flightmodel2/controls/elevator_trim" ] },
    { "do": "cas", "note": "終わり" },
    { "do": "shot", "name": "panel_end" },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
