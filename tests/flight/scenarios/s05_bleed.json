{
  "name": "s05_bleed",
  "description": "空圧（1-5）の X-Plane での確認。エンジン運転中の地上で開始し、ISOLATION L を OFF（VALVE 灯は移動中だけ点く）、ENGINE BLEED 1 を OFF（PRSOV 閉、OFF 灯、>BLEED 1 OFF）、その状態で NAI 1 を ON（PRV が開いてナセルに空気が行く）にして、弁・圧・P5 の灯・EICAS を見る。最後に AC bus 1 を切った状態で ISOLATION L を OFF（弁は動けない）にし、10 秒の不一致で出る BLEED ISLN L と beeper の合図を見る。期待値は FCOM 2.10-2.50 と LH36（notes/ATA-36.md）。圧の値は推定。",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "sleep", "seconds": 8 },
    { "do": "snapshot", "note": "開始直後", "drefs": [
      "sim/aircraft/view/acf_relative_path", "sim/flightmodel/engine/ENGN_N2_[0]",
      "laminar/B747/air/engine1/bleed_air_psi", "laminar/B747/air/engine4/bleed_air_psi",
      "laminar/B747/air/engine1/bleed_valve_pos", "laminar/B747/air/engine4/bleed_valve_pos",
      "laminar/B747/air/engine1/bleed_start_valve_pos",
      "laminar/B747/air/duct_pressure_L", "laminar/B747/air/duct_pressure_C", "laminar/B747/air/duct_pressure_R",
      "laminar/B747/air/isolation_valve_L_pos", "laminar/B747/air/isolation_valve_R_pos", "laminar/B747/air/apu/bleed_valve_pos",
      "laminar/B747/air/pack_ctrl/sel_dial_pos[0]", "laminar/B747/air/pack_ctrl/sel_dial_pos[1]", "laminar/B747/air/pack_ctrl/sel_dial_pos[2]",
      "sim/cockpit2/pressurization/actuators/bleed_air_mode" ] },
    { "do": "cas", "note": "開始直後" },
    { "do": "check", "note": "PRSOV 1 開（FCOM p.576）", "dref": "laminar/B747/air/engine1/bleed_valve_pos", "op": "==", "value": 1 },
    { "do": "check", "note": "PRSOV 4 開", "dref": "laminar/B747/air/engine4/bleed_valve_pos", "op": "==", "value": 1 },
    { "do": "check", "note": "エンジン 1 の抽気（PRV の下流。推定 60 psi）", "dref": "laminar/B747/air/engine1/bleed_air_psi", "op": ">", "value": 50 },
    { "do": "check", "note": "左ダクト（idle 4 発、パック 3 台。値は推定）", "dref": "laminar/B747/air/duct_pressure_L", "op": ">", "value": 25 },
    { "do": "check", "note": "中央ダクト", "dref": "laminar/B747/air/duct_pressure_C", "op": ">", "value": 25 },
    { "do": "check", "note": "右ダクト", "dref": "laminar/B747/air/duct_pressure_R", "op": ">", "value": 25 },
    { "do": "check", "note": "ENGINE BLEED 1 OFF 灯 消灯", "dref": "laminar/B747/annunciator/brightness_ratio[75]", "op": "==", "value": 0 },
    { "do": "check", "note": "ISLN L VALVE 灯 消灯", "dref": "laminar/B747/annunciator/brightness_ratio[72]", "op": "==", "value": 0 },
    { "do": "check", "note": "SYS FAULT 1 消灯", "dref": "laminar/B747/annunciator/brightness_ratio[118]", "op": "==", "value": 0 },
    { "do": "check", "note": ">BLEED 1 OFF なし", "dref": "laminar/B747/CAS/advisory_status[39]", "op": "==", "value": 0 },
    { "do": "check", "note": "X-Plane 自身の抽気は auto（5）。X-Plane の isolation valve は mode に連動する", "dref": "sim/cockpit2/pressurization/actuators/bleed_air_mode", "op": "==", "value": 5 },
    { "do": "check", "note": "X-Plane の isolation valve L が開（X-Plane のエアスターターに要る）", "dref": "sim/cockpit2/bleedair/actuators/isol_valve_left", "op": "==", "value": 1 },
    { "do": "check", "note": "X-Plane の isolation valve R", "dref": "sim/cockpit2/bleedair/actuators/isol_valve_right", "op": "==", "value": 1 },
    { "do": "view", "name": "bleed" },
    { "do": "shot", "name": "bleed_start" },

    { "do": "mark", "note": "ISOLATION L OFF" },
    { "do": "switch", "note": "ISOLATION L OFF", "dref": "laminar/B747/button_switch/position[75]", "value": 0, "cmd": "laminar/B747/button_switch/bleed_air_isln_vlv_L" },
    { "do": "wait", "note": "移動中は VALVE 灯（FCOM p.576、LH36 p.78）", "dref": "laminar/B747/air/light/isln_valve[0]", "op": "==", "value": 1, "timeout": 1.5 },
    { "do": "wait", "note": "P5 の VALVE 灯が点く", "dref": "laminar/B747/annunciator/brightness_ratio[72]", "op": ">", "value": 0, "timeout": 1.5 },
    { "do": "shot", "name": "bleed_isln_moving" },
    { "do": "wait", "note": "ISLN L 閉（約 2 秒。推定）", "dref": "laminar/B747/air/isolation_valve_L_pos", "op": "==", "value": 0, "timeout": 5 },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "閉じ終わると VALVE 灯 消灯", "dref": "laminar/B747/air/light/isln_valve[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "P5 の VALVE 灯 消灯", "dref": "laminar/B747/annunciator/brightness_ratio[72]", "op": "==", "value": 0 },
    { "do": "check", "note": "X-Plane の isolation valve L は開のまま（X-Plane の弁は mode に連動。乗員に見える弁はモデルの方）", "dref": "sim/cockpit2/bleedair/actuators/isol_valve_left", "op": "==", "value": 1 },
    { "do": "sleep", "seconds": 11 },
    { "do": "check", "note": "スイッチどおりなので BLEED ISLN L は出ない（不一致 10 秒で出る。ATA30_32_35_36 p.22）", "dref": "laminar/B747/CAS/advisory_status[35]", "op": "==", "value": 0 },
    { "do": "check", "note": "左ダクトはエンジン 1・2 から", "dref": "laminar/B747/air/duct_pressure_L", "op": ">", "value": 25 },
    { "do": "check", "note": "中央ダクトは ISLN R 経由でエンジン 3・4 から", "dref": "laminar/B747/air/duct_pressure_C", "op": ">", "value": 25 },

    { "do": "mark", "note": "ENGINE BLEED 1 OFF" },
    { "do": "switch", "note": "ENGINE BLEED 1 OFF", "dref": "laminar/B747/button_switch/position[77]", "value": 0, "cmd": "laminar/B747/button_switch/bleed_air_vlv_engine_1" },
    { "do": "wait", "note": "PRSOV 1 閉", "dref": "laminar/B747/air/engine1/bleed_valve_pos", "op": "==", "value": 0, "timeout": 3 },
    { "do": "wait", "note": ">BLEED 1 OFF（N2 50 % 以上で PRSOV 閉。LH36 p.68、FCOM p.619）", "dref": "laminar/B747/CAS/advisory_status[39]", "op": "==", "value": 1, "timeout": 3 },
    { "do": "wait", "note": "ENGINE BLEED 1 OFF 灯（PRSOV 閉。FCOM p.576）", "dref": "laminar/B747/annunciator/brightness_ratio[75]", "op": ">", "value": 0, "timeout": 2 },
    { "do": "check", "note": "PRV 1 も閉（エンジン側の圧 0）", "dref": "laminar/B747/air/engine1/bleed_air_psi", "op": "==", "value": 0 },
    { "do": "check", "note": "左ダクトはエンジン 2 だけで保つ", "dref": "laminar/B747/air/duct_pressure_L", "op": ">", "value": 20 },
    { "do": "check", "note": "SYS FAULT 1 は点かない", "dref": "laminar/B747/annunciator/brightness_ratio[118]", "op": "==", "value": 0 },
    { "do": "shot", "name": "bleed_bleed1_off" },
    { "do": "view", "name": "panel" },
    { "do": "shot", "name": "panel_bleed1_off" },
    { "do": "cas", "note": "ENGINE BLEED 1 OFF" },

    { "do": "mark", "note": "NAI 1 ON（BLEED 1 OFF のまま）" },
    { "do": "switch", "note": "NAI 1 ON", "dref": "laminar/B747/button_switch/position[68]", "value": 1, "cmd": "laminar/B747/button_switch/anti_ice_nacelle_1" },
    { "do": "wait", "note": "NAI で PRV が開く（FCOM p.576）", "dref": "laminar/B747/air/engine1/bleed_air_psi", "op": ">", "value": 50, "timeout": 3 },
    { "do": "wait", "note": "ナセル防氷弁 1 が開く", "dref": "laminar/B747/antiice/nacelle/valve_pos[0]", "op": ">", "value": 0.9, "timeout": 10 },
    { "do": "check", "note": "PRSOV 1 は閉のまま", "dref": "laminar/B747/air/engine1/bleed_valve_pos", "op": "==", "value": 0 },
    { "do": "check", "note": ">BLEED 1 OFF は出たまま", "dref": "laminar/B747/CAS/advisory_status[39]", "op": "==", "value": 1 },
    { "do": "cas", "note": "NAI 1 ON" },
    { "do": "switch", "note": "NAI 1 OFF", "dref": "laminar/B747/button_switch/position[68]", "value": 0, "cmd": "laminar/B747/button_switch/anti_ice_nacelle_1" },
    { "do": "wait", "note": "PRV 1 が閉じる", "dref": "laminar/B747/air/engine1/bleed_air_psi", "op": "==", "value": 0, "timeout": 3 },

    { "do": "mark", "note": "復旧" },
    { "do": "switch", "note": "ENGINE BLEED 1 ON", "dref": "laminar/B747/button_switch/position[77]", "value": 1, "cmd": "laminar/B747/button_switch/bleed_air_vlv_engine_1" },
    { "do": "wait", "note": "PRSOV 1 開", "dref": "laminar/B747/air/engine1/bleed_valve_pos", "op": "==", "value": 1, "timeout": 5 },
    { "do": "wait", "note": ">BLEED 1 OFF が消える", "dref": "laminar/B747/CAS/advisory_status[39]", "op": "==", "value": 0, "timeout": 3 },
    { "do": "switch", "note": "ISOLATION L ON", "dref": "laminar/B747/button_switch/position[75]", "value": 1, "cmd": "laminar/B747/button_switch/bleed_air_isln_vlv_L" },
    { "do": "wait", "note": "ISLN L 開", "dref": "laminar/B747/air/isolation_valve_L_pos", "op": "==", "value": 1, "timeout": 5 },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "X-Plane 自身の抽気は auto のまま", "dref": "sim/cockpit2/pressurization/actuators/bleed_air_mode", "op": "==", "value": 5 },
    { "do": "check", "note": "VALVE 灯 消灯", "dref": "laminar/B747/annunciator/brightness_ratio[72]", "op": "==", "value": 0 },
    { "do": "check", "note": "OFF 灯 消灯", "dref": "laminar/B747/annunciator/brightness_ratio[75]", "op": "==", "value": 0 },
    { "do": "cas", "note": "復旧後" },

    { "do": "mark", "note": "AC bus 1 なしで ISOLATION L OFF" },
    { "do": "switch", "note": "CTR L ポンプ OFF（中央タンクが少ないと燃料系が 60 秒後に FUEL PRESS CTR を出して master CAUTION を点けるので、この確認の間は止める）", "dref": "laminar/B747/button_switch/position[52]", "value": 0, "cmd": "laminar/B747/button_switch/fuel_ctr_wing_tnk_pump_L" },
    { "do": "switch", "note": "CTR R ポンプ OFF", "dref": "laminar/B747/button_switch/position[53]", "value": 0, "cmd": "laminar/B747/button_switch/fuel_ctr_wing_tnk_pump_R" },
    { "do": "switch", "note": "GEN CONT 1 OFF", "dref": "laminar/B747/button_switch/position[22]", "value": 0, "cmd": "laminar/B747/button_switch/elec_gen_ctrl_1" },
    { "do": "switch", "note": "BUS TIE 1 OFF", "dref": "laminar/B747/button_switch/position[18]", "value": 0, "cmd": "laminar/B747/button_switch/elec_bus_tie_1" },
    { "do": "wait", "note": "AC bus 1 が落ちる", "dref": "laminar/B747/electrical/bus/ac[0]", "op": "==", "value": 0, "timeout": 10 },
    { "do": "sleep", "seconds": 12 },
    { "do": "cas", "note": "AC bus 1 なし" },
    { "do": "cmd", "note": "master リセットで、AC bus 1 を失って出た caution の灯を消す", "name": "laminar/B747/button_switch/warn_caut_capt", "duration": 0.2 },
    { "do": "sleep", "seconds": 1.5 },
    { "do": "check", "note": "前提：master CAUTION が消えている", "dref": "laminar/B747/warning/master_caution", "op": "==", "value": 0 },
    { "do": "switch", "note": "ISOLATION L OFF（ISLN L のモーターは AC bus 1）", "dref": "laminar/B747/button_switch/position[75]", "value": 0, "cmd": "laminar/B747/button_switch/bleed_air_isln_vlv_L" },
    { "do": "check", "note": "弁は開のまま（LH36 p.86。電源が無いと止まるのは推定）", "dref": "laminar/B747/air/isolation_valve_L_pos", "op": "==", "value": 1 },
    { "do": "check", "note": "スイッチと弁が不一致なので VALVE 灯（FCOM p.576）", "dref": "laminar/B747/air/light/isln_valve[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "10 秒たつまで BLEED ISLN L は出ない", "dref": "laminar/B747/CAS/advisory_status[35]", "op": "==", "value": 0 },
    { "do": "wait", "note": "10 秒の不一致で BLEED ISLN L（ATA30_32_35_36 p.22）", "dref": "laminar/B747/CAS/advisory_status[35]", "op": "==", "value": 1, "timeout": 13 },
    { "do": "wait", "note": "beeper の合図（FCOM p.619：advisory で beeper あり）", "dref": "laminar/B747/warning/master_caution_audio", "op": "==", "value": 1, "timeout": 1 },
    { "do": "check", "note": "master CAUTION は点かない", "dref": "laminar/B747/warning/master_caution", "op": "==", "value": 0 },
    { "do": "cas", "note": "BLEED ISLN L" },
    { "do": "switch", "note": "ISOLATION L ON（スイッチと弁が一致）", "dref": "laminar/B747/button_switch/position[75]", "value": 1, "cmd": "laminar/B747/button_switch/bleed_air_isln_vlv_L" },
    { "do": "wait", "note": "VALVE 灯が消える", "dref": "laminar/B747/air/light/isln_valve[0]", "op": "==", "value": 0, "timeout": 2 },
    { "do": "wait", "note": "BLEED ISLN L が消える", "dref": "laminar/B747/CAS/advisory_status[35]", "op": "==", "value": 0, "timeout": 3 },
    { "do": "switch", "note": "BUS TIE 1 AUTO", "dref": "laminar/B747/button_switch/position[18]", "value": 1, "cmd": "laminar/B747/button_switch/elec_bus_tie_1" },
    { "do": "switch", "note": "GEN CONT 1 ON", "dref": "laminar/B747/button_switch/position[22]", "value": 1, "cmd": "laminar/B747/button_switch/elec_gen_ctrl_1" },
    { "do": "wait", "note": "AC bus 1 が戻る", "dref": "laminar/B747/electrical/bus/ac[0]", "op": "==", "value": 1, "timeout": 15 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
